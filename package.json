    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "xterm-pty": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
