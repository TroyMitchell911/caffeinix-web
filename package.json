{
  "name": "caffeinix-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "serve": "node scripts/serve.mjs --root dist",
